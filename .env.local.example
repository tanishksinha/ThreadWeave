# ThreadWeave & LiveKit Configuration
# Fill in your LiveKit Cloud and OpenAI credentials below:

# LiveKit Cloud credentials (sign up for free at https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# OpenAI or Groq API Key
# - For standard OpenAI (Whisper + GPT-4o + TTS-1): use sk-...
# - For ultra-fast Groq LPU (Whisper-large-v3 + gpt-oss-120b + EdgeTTS): use gsk-...
OPENAI_API_KEY=sk-your-openai-or-groq-key-here

